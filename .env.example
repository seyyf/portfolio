# Copy to .env.local and fill in. Never commit .env.local.

# Contact form (the phone's Messages app and /contact): your Formspree form endpoint, or just its ID.
# https://formspree.io → New form → set the email to mejri.seyf@gmail.com → copy the endpoint.
# In the form's Settings, turn reCAPTCHA off (messages are sent from the server).
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Public base URL for canonical/Open Graph URLs, sitemap and JSON-LD (no trailing slash).
# Optional: production builds default to https://www.seyfmejri.tn. Set it only to override that.
# NEXT_PUBLIC_SITE_URL=https://www.seyfmejri.tn
